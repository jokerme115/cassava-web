{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: run django",
      "type": "shell",
      "command": "conda run -n hetao python manage.py runserver 0.0.0.0:8000",
      "options": {
        "cwd": "${workspaceFolder}/网页/back/cassavaBack"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/网页/back/cassavaBack"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Starting development server at|http://127\\.0\\.0\\.1:8000/|http://0\\.0\\.0\\.0:8000/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "fullstack",
        "clear": false
      }
    },
    {
      "label": "frontend: run vite",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5174",
      "options": {
        "cwd": "${workspaceFolder}/网页/front/cassava_front"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/网页/front/cassava_front"
        ],
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:|ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "fullstack",
        "clear": false
      }
    },
    {
      "label": "dev: run frontend and backend",
      "dependsOrder": "parallel",
      "dependsOn": [
        "backend: run django",
        "frontend: run vite"
      ],
      "problemMatcher": []
    }
  ]
}
