/* pages/register/register.wxss */
.register-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F5F7F5 35%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.head {
  padding: 60rpx 8rpx 48rpx;
}
.head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1B5E20;
}
.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #607D8B;
}

.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(38, 50, 56, 0.06);
}

.field {
  position: relative;
  margin-bottom: 36rpx;
}
.field-label {
  font-size: 26rpx;
  color: #607D8B;
  margin-bottom: 14rpx;
}
.field-input {
  height: 92rpx;
  background: #F5F7F5;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #263238;
  box-sizing: border-box;
}
.ph {
  color: #B0BEC5;
}

.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.code-input {
  flex: 1;
}
.code-btn {
  width: 220rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.code-btn.disabled {
  background: #F5F7F5;
  color: #B0BEC5;
}

.pwd-toggle {
  position: absolute;
  right: 28rpx;
  bottom: 0;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 26rpx;
  color: #2E7D32;
}

.reg-btn {
  margin-top: 20rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.to-login {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #607D8B;
}
.link {
  color: #2E7D32;
  font-weight: 600;
}
