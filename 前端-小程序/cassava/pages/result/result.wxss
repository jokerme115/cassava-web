/* pages/result/result.wxss */
.result-page {
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 批量切换 */
.batch-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.batch-item {
  display: inline-block;
  margin-right: 16rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 3rpx solid transparent;
}
.batch-item.active {
  border-color: #2E7D32;
}
.batch-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

/* PPD 主卡片 */
.hero {
  background: linear-gradient(135deg, #43A047, #1B5E20);
  border-radius: 28rpx;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(27, 94, 32, 0.28);
  margin-bottom: 24rpx;
}
.hero-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}
.hero-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 16rpx 0 8rpx;
}
.hero-num {
  font-size: 140rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.hero-unit {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 8rpx;
  font-weight: 600;
}
.tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.95);
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.tag-success { color: #2E7D32; }
.tag-info    { color: #1565C0; }
.tag-warning { color: #EF6C00; }
.tag-danger  { color: #C62828; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(38, 50, 56, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #263238;
  margin-bottom: 20rpx;
}

/* 图像查看 */
.tab-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.tab {
  padding: 10rpx 30rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #607D8B;
  background: #F5F7F5;
}
.tab.active {
  background: #E8F5E9;
  color: #2E7D32;
  font-weight: 600;
}
.viewer-img {
  width: 100%;
  border-radius: 16rpx;
}
.viewer-empty {
  color: #B0BEC5;
  font-size: 26rpx;
  padding: 80rpx 0;
  text-align: center;
}
.image-name {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #90A4AE;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 子图横向滚动行 */
.subimg-row {
  white-space: nowrap;
}
.subimg {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F5F7F5;
  margin-right: 16rpx;
}
.subimg:last-child {
  margin-right: 0;
}

/* 建议 */
.suggest-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #546E7A;
  line-height: 1.7;
  margin-bottom: 8rpx;
}
.suggest-item:last-child {
  margin-bottom: 0;
}
.suggest-dot {
  color: #FFA726;
  margin-right: 12rpx;
  font-weight: 700;
}

/* 分区域 PPD 横向条 */
.sub-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.sub-item {
  display: flex;
  align-items: center;
}
.sub-label {
  width: 110rpx;
  font-size: 26rpx;
  color: #607D8B;
  flex-shrink: 0;
}
.sub-bar {
  flex: 1;
  height: 16rpx;
  background: #ECEFF1;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 20rpx;
}
.sub-fill {
  height: 100%;
  background: linear-gradient(90deg, #66BB6A, #2E7D32);
  border-radius: 8rpx;
}
.sub-value {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #2E7D32;
  flex-shrink: 0;
}

/* 底部 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}
.action-half {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
}
.btn-outline {
  background: #fff;
  color: #2E7D32;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(38, 50, 56, 0.05);
}
.btn-outline::after {
  border: none;
}

/* 空态 / 错误态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  color: #90A4AE;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 28rpx;
}
.retry-btn {
  margin-top: 24rpx;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
}
.retry-btn::after {
  border: none;
}
