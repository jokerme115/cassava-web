# Database Configuration
DB_NAME=test
DB_USER=cassava
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Security
DEBUG=False
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=your_domain.com,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your_domain.com,http://your_domain.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# 如果 HTTPS 在 Nginx / ALB / 反向代理终止，保持 True
USE_X_FORWARDED_PROTO=True

# Logging
# Server logs are written to back/cassavaBack/logs by default.
LOG_DIR=
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
LOG_RETENTION_DAYS=14

# Mini App
MINIAPP_ACCESS_TOKEN=

# DeepLab model selection
DEFAULT_DEEPLAB_MODEL_KEY=resnet101
DEEPLABV3_RESNET101_PATH=
DEEPLABV3_RESNET50_PATH=
DEEPLABV3_MOBILENET_PATH=

# File storage
# local: store uploaded files under MEDIA_ROOT on the server.
# oss: store uploaded files in Alibaba Cloud OSS.
FILE_STORAGE_BACKEND=local
# Upload and editor resource limits (bytes unless otherwise noted)
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=576716800
CORRECTION_MASK_MAX_BYTES=26214400
CORRECTION_MASK_MAX_PIXELS=50000000
# The local database-backed prediction runner is deliberately bounded.
PREDICTION_TASK_WORKERS=1
PREDICTION_TASK_STALE_MINUTES=30
# When FILE_STORAGE_BACKEND=local, keep this True to allow existing OSS-backed
# database records to still generate signed OSS URLs if the local file is absent.
OSS_READ_FALLBACK=True

# OSS
OSS_BUCKET=your-bucket-name
OSS_REGION=cn-guangzhou
OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
# 如果后端部署在同地域阿里云服务器，可填写内网 Endpoint 降低流量成本
OSS_INTERNAL_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
# 推荐保持 signed，并把 Bucket ACL 设为 private
OSS_URL_ACCESS_MODE=signed
OSS_SIGNED_URL_EXPIRE_SECONDS=1800
OSS_SIGNED_URL_SLASH_SAFE=True

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_SUBJECT=注册验证码
EMAIL_CODE_TEMPLATE=你的验证码是 {code}，{minutes} 分钟内有效。
